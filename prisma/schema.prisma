generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  passport  PassportProfile?
}

model PassportProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  nationality      String
  currentCountry   String
  currentCity      String
  languages        String   @default("[]")
  countriesLived   String   @default("[]")
  countriesVisited String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CountryInsight {
  id                 String   @id @default(cuid())
  countryCode        String   @unique
  countryName        String
  costOfLiving       String?
  friendlinessRating Float?
  languageSituation  String?
  culturalTips       String?
  commonMistakes     String?
  foreignerQuotes    String?  @default("[]")
  activeUserCount    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
