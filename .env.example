# Local development
DATABASE_URL="file:./dev.db"
DATA_DIR=./data

# Auth sessions (generate a long random string for production)
AUTH_SECRET=change-me-to-a-long-random-string

# Email verification via Resend — https://resend.com
# Required for email verification + password reset:
# 1. Create a Resend account and API key
# 2. Add and verify your domain (DNS records in Resend dashboard)
# 3. Use a no-reply sender on that domain:
RESEND_API_KEY=re_xxxxxxxx
AUTH_FROM_EMAIL="Foreigners Club <noreply@yourdomain.com>"

# Without Resend, signup still works (accounts are verified immediately).
# Force-require verification even without Resend:
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Or disable verification even with Resend:
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Apple App Review demo account (created/updated automatically on login/signup)
APP_REVIEW_EMAIL=review@foreigners.club
APP_REVIEW_PASSWORD=ChangeMeAppReview1
APP_REVIEW_NAME=App Reviewer

# Local testing only — shows codes in API/app instead of sending email
# AUTH_DEV_CODES=true

# Optional — Google Places photos in country Feed tab
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Optional
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Sign in with Apple (defaults to iOS bundle id com.foreignersclub.app)
# APPLE_CLIENT_ID=com.foreignersclub.app

# Production on Render (set in dashboard):
# DATA_DIR=/var/data
# DATABASE_URL=file:/var/data/app.db
